# Database lokal Xubuntu via app-karyawan/docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/hub_karyawan?schema=public"

# Backend Express
PORT=4000
EMPLOYEE_AUTH_SECRET="dev-employee-auth-secret"
ADMIN_AUTH_SECRET="dev-admin-auth-secret"

# Frontend dan URL publik Cloudflare Tunnel
# Dev lokal pakai proxy Vite -> backend lokal di port 4000.
# Override ini hanya berlaku saat dev. Build production tetap memakai .env.production.
VITE_API_BASE_URL="/api"
APP_BASE_URL="https://aplikasi-hub.my.id"
EMPLOYEE_PWA_BASE_URL="https://pwa.aplikasi-hub.my.id"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.21:5173,http://192.168.60.29:5173,http://192.168.60.29:5178,http://192.168.1.11:5173,http://192.168.1.143:5173,https://aplikasi-hub.my.id,https://www.aplikasi-hub.my.id,https://pwa.aplikasi-hub.my.id,https://admin.aplikasi-hub.my.id,https://app.aplikasi-hub.my.id"

