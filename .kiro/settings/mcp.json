{
  "mcpServers": {
    "mui": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@mui/mcp@latest"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      },
      "disabled": false,
      "autoApprove": []
    },
    "codegraph": {
      "command": "codegraph-mcp",
      "args": [
        "serve",
        "--repo",
        "E:\\Github\\aplikasi-hub-karyawan\\app-karyawan"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "query_codebase",
        "find_dependencies",
        "find_callers",
        "find_callees",
        "get_code_snippet",
        "get_file_structure",
        "analyze_module_structure",
        "execute_shell_command",
        "read_file_content",
        "global_search"
      ]
    }
  }
}